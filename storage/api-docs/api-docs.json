{
    "openapi": "3.0.0",
    "info": {
        "title": "ZipLink API Documentation",
        "description": "Высокопроизводительный сервис сокращения ссылок и сбора аналитики",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Основной API сервер"
        }
    ],
    "paths": {
        "/link/{code}/analytics": {
            "get": {
                "tags": [
                    "Аналитика"
                ],
                "summary": "Сводная аналитика по кликам ссылки",
                "operationId": "9a186ef2daa5bc293c1ae1459a751acf",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "1C"
                        }
                    },
                    {
                        "name": "days",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 30
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Агрегированные данные для графиков",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "total_clicks": {
                                                    "type": "integer",
                                                    "example": 120
                                                },
                                                "clicks_over_time": {
                                                    "type": "object"
                                                },
                                                "countries": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                },
                                                "devices": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                },
                                                "browsers": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                },
                                                "platforms": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                },
                                                "referers": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Нет доступа к чужой аналитике"
                    },
                    "404": {
                        "description": "Ссылка не найдена"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/tokens": {
            "get": {
                "tags": [
                    "API Tokens"
                ],
                "summary": "Получение списка активных API-токенов",
                "operationId": "eb66ab14ef6279023894ef3391698c5c",
                "responses": {
                    "200": {
                        "description": "Список токенов",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "name": {
                                                        "type": "string",
                                                        "example": "Bot Token"
                                                    },
                                                    "last_used_at": {
                                                        "type": "string",
                                                        "example": null,
                                                        "nullable": true
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "example": "2026-09-19T22:00:00Z"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "API Tokens"
                ],
                "summary": "Выпуск нового персонального API-токена",
                "operationId": "699699145f4e71e9ed09da22a7dcac0a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "CI/CD Token"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Токен создан (показывается только 1 раз)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Token created successfully."
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abcdef123456..."
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "API Tokens"
                ],
                "summary": "Отозвать все токены текущего пользователя",
                "operationId": "2b2d9f3b72042461228e65a44fe70611",
                "responses": {
                    "200": {
                        "description": "Все токены успешно отозваны"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/tokens/{tokenId}": {
            "delete": {
                "tags": [
                    "API Tokens"
                ],
                "summary": "Отозвать конкретный токен по ID",
                "operationId": "b71924377d4ef786c3a929d791d60c23",
                "parameters": [
                    {
                        "name": "tokenId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Токен отозван"
                    },
                    "404": {
                        "description": "Токен не найден"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/{code}": {
            "get": {
                "tags": [
                    "Ссылки"
                ],
                "summary": "Получение целевого URL по коду (с асинхронным трекингом клика)",
                "operationId": "30ff48c2b83da348b9cf26fefa35a9a6",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "1C"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный возврат URL",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "string",
                                            "example": "https://example.com/long-page"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Ссылка защищена паролем (требуется POST /{code}/guard)"
                    },
                    "404": {
                        "description": "Ссылка не найдена или истекла"
                    }
                }
            }
        },
        "/link": {
            "get": {
                "tags": [
                    "Ссылки"
                ],
                "summary": "Получение списка ссылок пользователя",
                "operationId": "4eba332685aa82251779407d00c782df",
                "responses": {
                    "200": {
                        "description": "Список ссылок пользователя",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "original_url": {
                                                        "type": "string",
                                                        "example": "https://example.com"
                                                    },
                                                    "short_code": {
                                                        "type": "string",
                                                        "example": "FXsz"
                                                    },
                                                    "is_active": {
                                                        "type": "boolean",
                                                        "example": true
                                                    },
                                                    "clicks_count": {
                                                        "type": "integer",
                                                        "example": 42
                                                    },
                                                    "expired_at": {
                                                        "type": "string",
                                                        "example": "2026-10-01T22:17:46.000000Z",
                                                        "nullable": true
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "example": "2026-09-24T22:17:46.000000Z"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "example": "2026-09-24T22:17:46.000000Z"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Не авторизован"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/{code}/guard": {
            "post": {
                "tags": [
                    "Ссылки"
                ],
                "summary": "Получение URL для ссылки, защищенной паролем",
                "operationId": "1fb55b9d4692101881b1f4cf040681c6",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "1C"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "password"
                                ],
                                "properties": {
                                    "password": {
                                        "type": "string",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Пароль верный, возврат URL",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "string",
                                            "example": "https://example.com/long-page"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Неверный пароль"
                    },
                    "404": {
                        "description": "Ссылка не найдена или истекла"
                    }
                }
            }
        },
        "/": {
            "post": {
                "tags": [
                    "Ссылки"
                ],
                "summary": "Создание короткой ссылки",
                "operationId": "24520beaf9bb1ed179a58091cb873026",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "link"
                                ],
                                "properties": {
                                    "link": {
                                        "type": "string",
                                        "format": "uri",
                                        "example": "https://example.com/long-page"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret123",
                                        "nullable": true
                                    },
                                    "expired_at": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-12-31T23:59:59Z",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Ссылка успешно создана",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "code": {
                                            "type": "string",
                                            "example": "FXsz"
                                        },
                                        "link": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 15
                                                },
                                                "user_id": {
                                                    "type": "integer",
                                                    "example": 8,
                                                    "nullable": true
                                                },
                                                "original_url": {
                                                    "type": "string",
                                                    "example": "https://example.com/long-page"
                                                },
                                                "short_code": {
                                                    "type": "string",
                                                    "example": "FXsz"
                                                },
                                                "expired_at": {
                                                    "type": "string",
                                                    "example": "2026-10-01T22:17:46.000000Z",
                                                    "nullable": true
                                                },
                                                "is_active": {
                                                    "type": "boolean",
                                                    "example": true
                                                },
                                                "clicks_count": {
                                                    "type": "integer",
                                                    "example": 0
                                                },
                                                "created_at": {
                                                    "type": "string",
                                                    "example": "2026-09-24T22:17:46.000000Z"
                                                },
                                                "updated_at": {
                                                    "type": "string",
                                                    "example": "2026-09-24T22:17:46.000000Z"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                }
            }
        },
